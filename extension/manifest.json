{
  "manifest_version": 3,
  "name": "CLIFF - Career Intelligence & Autofill",
  "version": "1.0.0",
  "description": "Private, local-first career intelligence, LinkedIn job scraper, ATS form-autofiller, and Workday application status sync.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CLIFF Career Intelligence",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "alarms",
    "cookies"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "*://*.linkedin.com/*",
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.myworkdayjobs.com/*",
    "*://*.myworkday.com/*",
    "*://*.ashbyhq.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*"
      ],
      "js": ["content-scraper.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.myworkday.com/*",
        "*://*.ashbyhq.com/*",
        "*://*/*apply*",
        "*://*/*application*"
      ],
      "js": ["content-autofill.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.myworkdayjobs.com/*",
        "*://*.myworkday.com/*"
      ],
      "js": ["content-workday.js"],
      "run_at": "document_idle"
    }
  ]
}

