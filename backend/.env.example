# CLIFF Backend Configuration
PORT=8000
# Neon Serverless PostgreSQL Connection String
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/cliff?sslmode=require

# GCP Cloud Infrastructure & Keyless Vertex AI (Uses IAM / Application Default Credentials)
GCP_PROJECT_ID=cliff-512020
GCP_REGION=us-central1
USE_VERTEX_AI=true
GEMINI_MODEL=gemini-2.5-flash
GCS_RESUMES_BUCKET=cliff-resumes-prod-b3e45c44
GCS_TAILORED_BUCKET=cliff-tailored-prod-b3e45c44
SERVICE_ACCOUNT_EMAIL=cliff-app-sa-prod@cliff-512020.iam.gserviceaccount.com

# Optional Local Fallbacks (if Vertex AI is disabled)
GEMINI_API_KEY=
OPENAI_API_KEY=
